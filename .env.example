# Every variable below is documented in arch/conventions.md §4. Copy this file to
# .env and fill in real secrets before running services outside of dev.

# --- Data stores (apps/api only touches these — arch/system-design.md §2) ---
# Postgres connection string used by Drizzle/pg (arch/system-design.md §3).
DATABASE_URL=postgres://sketchy:sketchy@localhost:5432/sketchy
# Redis connection string — live room state, presence, rate limits (§4).
REDIS_URL=redis://localhost:6379

# --- Auth (arch/system-design.md §6) ---
# HS256 secret signing guest/player JWTs. Replace with a long random value.
JWT_SECRET=dev-only-change-me
# Previous HS256 secret, accepted during rotation windows (dual-secret rotation).
JWT_SECRET_PREVIOUS=

# --- Networking / CORS ---
# Comma-separated list of origins allowed to call the API / open sockets.
CORS_ORIGINS=http://localhost:3000
# Public URL of the Next.js web app (used in emails, invite links, CORS).
PUBLIC_WEB_URL=http://localhost:3000
# Public URL of the Fastify API (used by the web client's typed REST client).
PUBLIC_API_URL=http://localhost:4000
# Port the Fastify API process listens on.
PORT=4000
# Optional public repo URL for the marketing footer's "GitHub" link (phase 14,
# apps/web src/components/marketing/site-footer.tsx). UNSET = the link is omitted — the
# footer never hardcodes a repo URL, so a private working repo never leaks into the public
# site. Set this only once the repo is genuinely public.
NEXT_PUBLIC_GITHUB_URL=

# --- Cloudflare R2 (user uploads, DB backups — arch/system-design.md §9) ---
# R2 account ID from the Cloudflare dashboard.
R2_ACCOUNT_ID=changeme
# R2 S3-compatible access key ID.
R2_ACCESS_KEY_ID=changeme
# R2 S3-compatible secret access key.
R2_SECRET_ACCESS_KEY=changeme
# R2 bucket name holding uploads and nightly backups.
R2_BUCKET=sketchy-dev
# Public base URL (custom domain) reads are served from, e.g. cdn.sketchy.example.
R2_PUBLIC_BASE_URL=https://cdn.example.com

# --- Observability / admin ---
# pino log level (apps/api). One of: trace, debug, info, warn, error, fatal, silent.
# Defaults to 'info' when unset.
LOG_LEVEL=info
# Sentry DSN for API + web error tracking (free tier at launch). Empty disables it.
SENTRY_DSN=
# Bearer token gating the admin-only stats/metrics/reports endpoints (apps/api). Server-side
# only — never exposed to any client bundle. The public landing counter does NOT use it: it
# reads the low-privilege GET /v1/stats/games-today instead, so the web tier holds no admin
# token at all. Must be set or the API refuses to boot under NODE_ENV=production.
ADMIN_TOKEN=dev-only-change-me

# --- Accounts / email (phase 16 magic-link linking, arch/system-design.md §6) ---
# Transactional-email provider: 'log' (dev default — LOGS the magic link, never sends),
# 'resend', or 'postmark'. Anything unset/unrecognized falls back to 'log'. The real
# providers are wired but DEFERRED to phase 9 (no credentials in this environment) — with
# EMAIL_API_KEY unset they throw rather than pretending to send. Never claims an email was sent.
# Phase-9 DNS/provider/suppression wiring lives in deploy/RUNBOOK.md's "Email (phase 16) — NOT
# DEPLOYED" section (parallel to the Voice section the LiveKit vars below point at).
EMAIL_PROVIDER=log
# From address the real providers send as (ignored by 'log').
EMAIL_FROM=Sketchy <no-reply@sketchy.example>
# API key / server token for the selected real provider. Empty for 'log'.
EMAIL_API_KEY=

# --- Sign in with Google (optional account-link method, arch/system-design.md §6) ---
# Ships DORMANT: an ADDITIONAL way to link an account (alongside the email magic link) that
# stays completely off until an operator provisions a Google OAuth client ID and opts in.
# Phase-9 provisioning steps (Cloud project, consent screen, authorized origins) live in
# deploy/RUNBOOK.md's "Google Sign-In — NOT DEPLOYED" section.
#
# OAuth client ID the API verifies browser-minted Google ID tokens against (as the audience).
# UNSET = feature unconfigured (POST /v1/auth/google returns a clean not_found, never a 500).
GOOGLE_CLIENT_ID=
# Feature flag — the INVERSE default of VOICE_ENABLED: OFF unless set to exactly "true".
# Turning it on in production WITHOUT a GOOGLE_CLIENT_ID is a fail-fast startup error
# (apps/api/src/startup-guards.ts) — set both together.
GOOGLE_SIGNIN_ENABLED=false
# The SAME client ID exposed to the web bundle (public by design — it's the OAuth client ID,
# not a secret). UNSET = the web renders no "Sign in with Google" button and never loads the
# Google Identity Services script (so no Google cookies). Set to the same value as
# GOOGLE_CLIENT_ID above when enabling the feature.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Matchmaking tuning (phase 16; optional — code defaults if unset) ---
# Matcher interval (ms, default 3000), how long the oldest waiter waits before a below-target
# room forms (ms, default 8000), and the stale-queue-entry drop age (ms, default 300000).
MATCH_INTERVAL_MS=
MATCH_FORM_AFTER_MS=
MATCH_STALE_MS=

# --- Resilience tuning (arch/game-design.md §8; optional — spec defaults if unset) ---
# Disconnect grace window before host migration, in ms (default 90000).
GRACE_WINDOW_MS=
# All-disconnected mid-game reap deadline, in ms (default 600000 = 10 min).
ABANDON_MS=
# How often the abandon reaper re-scans rooms, in ms (default 60000).
ABANDON_SWEEP_MS=

# --- Voice (LiveKit SFU, self-hosted — arch/system-design.md §8, phase 15) ---
# Read by apps/api (livekit-server-sdk token signing) AND returned VERBATIM to clients as
# GET /v1/rooms/:code/voice-token's `url` field — API and browser reach the SAME LiveKit
# endpoint in both dev (deploy/compose.dev.yml exposes it straight to localhost) and prod
# (voice.<domain> is directly, publicly reachable — deploy/RUNBOOK.md's "Voice (phase 15) —
# NOT DEPLOYED" section), so there is no separate internal-only URL to configure.
# Dev default (apps/api/src/env.ts) matches deploy/compose.dev.yml's livekit service.
LIVEKIT_URL=ws://localhost:7880
# API key/secret pair LiveKit verifies tokens against (deploy/compose.dev.yml's `LIVEKIT_KEYS`
# for the dev container — trivial values, dev-only, never reuse in prod).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-do-not-use-in-prod-32chars
# The client-facing wss URL apps/web uses as a build-time fallback (apps/web/src/lib/voice.ts)
# if the token response's own `url` field is ever unavailable — the PRIMARY source of truth
# is still the server-returned `url` (mobile-ready: a non-Next.js client never needs this var
# at all). Same value as LIVEKIT_URL above in dev; in prod this points at voice.<domain>.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Kill-switch (plan/phase15.md task 5): "false" makes the voice-token endpoint and the
# voice:state socket event both fail clean with `voice_disabled` (copy.md §9) — the game
# itself is completely unaffected either way. Unset/anything else = enabled.
VOICE_ENABLED=true
