# Production env template for deploy/compose.prod.yml. Copy to deploy/.env.prod on the
# VPS, fill in real values, and never commit the filled-in copy (`.env*` is gitignored,
# but double-check before any `git add -A`). Every var is also documented in
# arch/conventions.md §4 / .env.example — this file only adds the prod-shaped values
# (internal service hostnames, real domains) and the two vars unique to this compose file
# (POSTGRES_PASSWORD, APP_DOMAIN/API_DOMAIN for Caddy).

# --- Domains (Caddyfile) ---
APP_DOMAIN=app.sketchy.example
API_DOMAIN=api.sketchy.example

# --- Data stores ---
# Must match POSTGRES_PASSWORD below (postgres container reads that one directly; this
# full connection string is what the api process/migrate runner actually connect with).
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://sketchy:changeme@postgres:5432/sketchy
REDIS_URL=redis://redis:6379

# --- Auth ---
# Long random value, e.g. `openssl rand -hex 32`. Never reuse the dev default.
JWT_SECRET=changeme
JWT_SECRET_PREVIOUS=

# --- Networking ---
CORS_ORIGINS=https://app.sketchy.example
PUBLIC_WEB_URL=https://app.sketchy.example
PUBLIC_API_URL=https://api.sketchy.example
NEXT_PUBLIC_GITHUB_URL=

# --- Cloudflare R2 (uploads, DB backups) ---
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET=sketchy-prod
R2_PUBLIC_BASE_URL=https://cdn.sketchy.example

# --- Observability / admin ---
LOG_LEVEL=info
# Sentry project DSN (free tier at launch) — same DSN for api + web, each tags its own
# events (apps/api/src/observability.ts, apps/web/src/lib/observability.ts). Baked into
# the web image at BUILD time (see apps/web/Dockerfile), so changing this needs a rebuild
# of `web`, not just a container restart.
SENTRY_DSN=
# Long random value, distinct from JWT_SECRET. Gates admin stats/metrics endpoints.
ADMIN_TOKEN=changeme

# --- Optional surfaces — flip on when each is provisioned; the app runs correctly with
# them off. Email and Google need no new container (RUNBOOK.md "Email" / "Google Sign-In");
# voice has its own section below. ---
EMAIL_PROVIDER=log
EMAIL_FROM=Sketchy <no-reply@sketchy.example>
EMAIL_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_SIGNIN_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Voice (LiveKit) — RUNBOOK.md "Voice". OFF by default: keep VOICE_ENABLED=false and
# leave the rest as-is. To turn ON: provision DNS + cert + firewall per the RUNBOOK, start
# the stack with `--profile voice`, and set every value below. The dev pair
# (devkey / devsecret-...) must NEVER be reused in production. ---
VOICE_ENABLED=false
# The voice subdomain — a DNS-only (grey-cloud) A/AAAA record → VPS_PUBLIC_IP. Consumed by
# Caddy (VOICE_DOMAIN) and must match the `domain:` in deploy/livekit.yaml.
VOICE_DOMAIN=voice.sketchy.example
LIVEKIT_URL=wss://voice.sketchy.example
NEXT_PUBLIC_LIVEKIT_URL=wss://voice.sketchy.example
LIVEKIT_API_KEY=changeme
# Strong secret, e.g. `openssl rand -hex 32`. NEVER the dev 'devsecret-...' value.
LIVEKIT_API_SECRET=changeme
# The VPS's PUBLIC ip — the address LiveKit advertises for WebRTC media (RUNBOOK "Voice" §5).
VPS_PUBLIC_IP=203.0.113.10

# --- Optional tuning (blank = code default; see .env.example for the numbers) ---
MATCH_INTERVAL_MS=
MATCH_FORM_AFTER_MS=
MATCH_STALE_MS=
GRACE_WINDOW_MS=
ABANDON_MS=
ABANDON_SWEEP_MS=

# --- Image overrides (leave unset until CI pushes to a registry — see compose.prod.yml's
# header comment) ---
WEB_IMAGE=
API_IMAGE=
API_BUILD_IMAGE=
