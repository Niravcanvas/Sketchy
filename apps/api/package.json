{
  "name": "@sketchy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --log-level=warning",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reconcile": "tsx scripts/reconcile-totals.ts",
    "print:openapi": "tsx scripts/print-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@sentry/node": "^10.66.0",
    "@sketchy/engine": "workspace:^",
    "@sketchy/shared": "workspace:^",
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.9.0",
    "fastify-type-provider-zod": "^7.0.0",
    "google-auth-library": "^10.9.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "livekit-server-sdk": "^2.17.0",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sketchy/config": "workspace:^",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.22.5",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
